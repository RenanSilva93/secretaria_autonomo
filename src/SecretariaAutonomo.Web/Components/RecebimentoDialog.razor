@inject ApiClient Api
@inject ISnackbar Snackbar

@* "Recebi": registra o pagamento de um atendimento no financeiro. Fecha com Ok(true) depois de salvar. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Recebimento</MudText>
    </TitleContent>
    <DialogContent>
        <MudText><b>@Agendamento.Servico</b> · @Agendamento.Cliente</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @Formatacao.Periodo(Agendamento.Inicio, Agendamento.Fim, TimeZoneInfo.Local)
        </MudText>

        <MudNumericField @bind-Value="_valor" Label="Valor recebido" Min="0" Format="N2" Adornment="Adornment.Start" AdornmentText="R$"
                         Immediate="true" HelperText="Já vem com o preço do serviço; mude se deu desconto ou gorjeta." />

        <MudText Typo="Typo.caption" Class="d-block mt-4 mb-1">Forma de pagamento</MudText>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var f in Formatacao.FormasPagamento)
            {
                <MudButton Size="Size.Small" Color="Color.Primary" Variant="@(_forma == f ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => _forma = f)">
                    @Formatacao.FormaPagamento(f)
                </MudButton>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.AttachMoney"
                   OnClick="Receber" Disabled="@(_salvando || _valor <= 0)">
            Registrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public required IMudDialogInstance MudDialog { get; set; }
    [Parameter] public required AgendamentoDto Agendamento { get; set; }

    /// <summary>Preço atual do serviço.</summary>
    [Parameter] public decimal ValorSugerido { get; set; }

    private decimal _valor;
    private string _forma = "Pix";
    private bool _salvando;

    protected override void OnInitialized() => _valor = ValorSugerido;

    private async Task Receber()
    {
        _salvando = true;
        try
        {
            await Api.ReceberAgendamentoAsync(Agendamento.Id, new ReceberAgendamentoRequest(_valor, _forma));
            Snackbar.Add($"{_valor:C} de {Agendamento.Cliente} lançado no financeiro.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }
}
